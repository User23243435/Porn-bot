# Dummy search function (replace with actual)
def search_sites(query):
    # Simulate search delay
    import time
    time.sleep(2)
    return [f"Result {i} for {query}" for i in range(1, 6)]

class PornSearchApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Porn Searcher - Cool UI")
        self.geometry("700x500")
        self.configure(bg="#222")  # Dark background

        self.create_widgets()

    def create_widgets(self):
        # Title Label
        ttk.Style().configure("TLabel", foreground="white", background="#222", font=("Helvetica", 16, "bold"))
        ttk.Label(self, text="Enter Search Query:", style="TLabel").pack(pady=10)

        # Search Entry
        self.query_entry = ttk.Entry(self, width=50, font=("Helvetica", 14))
        self.query_entry.pack(pady=5)

        # Search Button
        self.search_button = ttk.Button(self, text="Search", command=self.start_search)
        self.search_button.pack(pady=10)

        # Results Text Box
        self.results_box = scrolledtext.ScrolledText(self, height=15, bg="#333", fg="white", font=("Helvetica", 12))
        self.results_box.pack(padx=10, pady=10, fill=tk.BOTH, expand=True)

    def start_search(self):
        query = self.query_entry.get()
        if not query:
            messagebox.showwarning("Input Error", "Please enter a search query.")
            return
        # Disable button during search
        self.search_button.config(state=tk.DISABLED)
        self.results_box.delete("1.0", tk.END)
        self.results_box.insert(tk.END, f"Searching for '{query}'...\n")
        # Run search in a separate thread to avoid UI freeze
        threading.Thread(target=self.perform_search, args=(query,), daemon=True).start()

    def perform_search(self, query):
        results = search_sites(query)  # Replace with actual search call
        self.results_box.delete("1.0", tk.END)
        for result in results:
            self.results_box.insert(tk.END, result + "\n")
        # Re-enable button
        self.search_button.config(state=tk.NORMAL)

if __name__ == "__main__":
    app = PornSearchApp()
    app.mainloop()
